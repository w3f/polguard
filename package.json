{
  "name": "polguard",
  "packageManager": "yarn@4.11.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/w3f/polguard.git"
  },
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Wt run build",
    "clean": "yarn workspaces foreach -W run clean && yarn run clean:root",
    "clean:root": "yarn dlx rimraf ./node_modules",
    "test": "yarn workspaces foreach -W run test",
    "test:integration": "yarn workspaces foreach -W run test:integration",
    "lint": "yarn workspaces foreach -W run lint",
    "start:chain:dev": "yarn workspace @w3f/polguard-chain start:dev",
    "start:chain": "yarn workspace @w3f/polguard-chain start",
    "start:matrix:dev": "yarn workspace @w3f/polguard-matrix start:dev",
    "start:matrix": "yarn workspace @w3f/polguard-matrix start",
    "start:incident:dev": "yarn workspace @w3f/polguard-incident start:dev",
    "start:incident": "yarn workspace @w3f/polguard-incident start"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
