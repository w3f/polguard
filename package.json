{
  "name": "monitoring-platform",
  "packageManager": "yarn@4.6.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/w3f/monitoring-platform.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Wt run build",
    "build:types": "yarn workspace @w3f/monitoring-types build",
    "build:config": "yarn workspace @w3f/monitoring-config build",
    "build:chain": "yarn workspace @w3f/monitoring-chain build",
    "build:telemetry": "yarn workspace @w3f/monitoring-telemetry build",
    "build:matrix": "yarn workspace @w3f/monitoring-matrix build",
    "build:api": "yarn workspace @w3f/monitoring-api build",
    "test": "yarn workspaces foreach -W run test",
    "test:types": "yarn workspace @w3f/monitoring-types test",
    "test:config": "yarn workspace @w3f/monitoring-config test",
    "test:chain": "yarn workspace @w3f/monitoring-chain test",
    "test:telemetry": "yarn workspace @w3f/monitoring-telemetry test",
    "test:matrix": "yarn workspace @w3f/monitoring-matrix test",
    "test:api": "yarn workspace @w3f/monitoring-api test",
    "test:api:integration": "yarn workspace @w3f/monitoring-api test:integration",
    "test:watch:all": "yarn workspaces foreach -W run test:watch",
    "test:watch:chain": "yarn workspace @w3f/monitoring-chain test:watch",
    "test:watch:telemetry": "yarn workspace @w3f/monitoring-telemetry test:watch",
    "test:watch:matrix": "yarn workspace @w3f/monitoring-matrix test:watch",
    "test:watch:config": "yarn workspace @w3f/monitoring-config test:watch",
    "test:watch:api": "yarn workspace @w3f/monitoring-api test:watch",
    "test:coverage": "yarn workspaces foreach -W run test:coverage",
    "lint": "yarn workspaces foreach -W run lint",
    "lint:fix": "yarn workspaces foreach -W run lint:fix",
    "start:chain:dev": "yarn workspace @w3f/monitoring-chain start:dev",
    "start:telemetry:dev": "yarn workspace @w3f/monitoring-telemetry start:dev",
    "start:matrix:dev": "yarn workspace @w3f/monitoring-matrix start:dev",
    "start:api:dev": "yarn workspace @w3f/monitoring-api start:dev",
    "version:types": "yarn workspace @w3f/monitoring-types version",
    "version:config": "yarn workspace @w3f/monitoring-config version",
    "publish:types": "yarn workspace @w3f/monitoring-types npm publish --access public",
    "publish:config": "yarn workspace @w3f/monitoring-config npm publish --access public",
    "clean": "yarn workspaces foreach -W run clean",
    "clean:all": "rm -rf node_modules && yarn workspaces foreach -W run clean"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
