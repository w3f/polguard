{
  "name": "monitoring-platform",
  "packageManager": "yarn@4.6.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/w3f/monitoring-platform.git"
  },
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Wt run build",
    "clean": "yarn workspaces foreach -W run clean && yarn run clean:root",
    "clean:root": "yarn dlx rimraf ./node_modules",
    "test": "yarn workspaces foreach -W run test",
    "test:integration": "yarn workspaces foreach -W run test:integration",
    "lint": "yarn workspaces foreach -W run lint",
    "start:chain:dev": "yarn workspace @w3f/monitoring-chain start:dev",
    "start:chain": "yarn workspace @w3f/monitoring-chain start",
    "start:matrix:dev": "yarn workspace @w3f/monitoring-matrix start:dev",
    "start:matrix": "yarn workspace @w3f/monitoring-matrix start",
    "start:incident:dev": "yarn workspace @w3f/monitoring-incident start:dev",
    "start:incident": "yarn workspace @w3f/monitoring-incident start:with-migrations"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
