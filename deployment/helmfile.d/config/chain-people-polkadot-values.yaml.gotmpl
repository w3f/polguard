{{ if eq .Environment.Name "ci" }}
image:
  tag: {{ env "CIRCLE_SHA1" | default "kind" }}
{{ else if eq .Environment.Name "local" }}
image:
  repo: localhost:5000/mp-chain
  tag: latest
{{ end }}

{{ if eq .Environment.Name "ci" }}
resources: null
{{ end }}

{{ if eq .Environment.Name "test" }}
image:
  tag: {{ env "IMAGE_TAG" }}
  imagePullPolicy: Always
monitoringConfig: null
config:
  environment: test
  redis:
    url: redis://redis-master:6379/0
  chain: PeoplePolkadot
  rpc:
    url: wss://rpc-people-polkadot.luckyfriday.io
  startBlock: 1565685
  monitoringGroupIds:
    - test-group-validator-1
  monitoringApi:
    baseUrl: http://api:3000
    endpoints:
      createIncident: /incidents
      resolveIncident: /incidents/resolve
      getConfig: /monitoring-config/groups
  httpServer:
    port: 3000
    host: 0.0.0.0
  logging:
    level: debug 
{{ end }}
