containerArgs: ["start:matrix"]

{{ if eq .Environment.Name "ci" }}
image:
  repo: web3f/monitoring-platform
  tag: {{ env "CIRCLE_SHA1" | default "kind" }}
{{ end }}

{{ if eq .Environment.Name "ci" }}
resources: null
{{ end }}

{{ if eq .Environment.Name "test" }}
image:
  repo: web3f/monitoring-platform
  tag: {{ env "IMAGE_TAG" }}
  imagePullPolicy: Always
{{ end }}
config:
  matrix:
    url: "https://matrix.web3.foundation"
    userId: "{{ env "MATRIX_USER" }}"
    tokenAuth:
      deviceId: "{{ env "MATRIX_DEVICE" }}"
      authToken: "{{ env "MATRIX_TOKEN" }}"
    rooms:
      - id: "!BabNKVNdOktKGafXzd:web3.foundation"
    logging:
      level: warn
  monitoringApi:
    baseUrl: "http://api:3000"
    endpoints:
      getIncidents: "/incidents"
      getIncident: "/incidents/:id"
      acknowledgeIncident: "/incidents/:id/acknowledge"
  logging:
    level: debug
