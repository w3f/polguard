auth:
  enablePostgresUser: true
  postgresPassword: "postgres"
  database: "monitoring"

primary:
  persistence:
    enabled: true
    size: 8Gi

{{ if eq .Environment.Name "test" }}
metrics:
  enabled: true
primary:
  resources:
    requests:
      cpu: 300m
      memory: 300Mi
    limits:
      cpu: 3000m
      memory: 3000Mi
{{ end }}      

{{ if eq .Environment.Name "ci" }}
primary:
  persistence:
    enabled: false
  resources: null  
{{ end }}
