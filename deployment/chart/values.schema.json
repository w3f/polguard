{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "image": { "$ref": "#/definitions/image" },
    "resources": { "$ref": "#/definitions/resources" },
    "serviceMonitorsEnabled": {
      "description": "Should ServiceMonitor resources be created?",
      "type": "boolean"
    },
    "prometheusRulesEnabled": {
      "description": "Should PrometheusRule resources be created?",
      "type": "boolean"
    },
    "chainServices": {
      "type": "object",
      "description": "Per-chain configurations. Each chain creates a new set of chain service instances.",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "allOf": [
            { "$ref": "#/definitions/svc" },
            { "required": [ "config", "containerArgs" ] }
          ]
        }
      }
    },
    "chainInitContainers": { "$ref": "#/definitions/initContainers" },

    "apiService": {
      "allOf": [
        { "$ref": "#/definitions/svc" },
        { "required": ["config", "containerArgs"] }
      ]
    },
    "apiInitContainers": { "$ref": "#/definitions/initContainers" },

    "matrixService": {
      "allOf": [
        { "$ref": "#/definitions/svc" },
        { "required": ["config", "containerArgs", "persistence"] }
      ]
    },
    "matrixInitContainers": { "$ref": "#/definitions/initContainers" },

    "configFetcher": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "description": "Cron schedule for fetching configs"
        },
        "defaultToken": {
          "type": "string",
          "description": "Default auth token for all sources"
        },
        "sources": {
          "type": "array",
          "description": "List of config sources to fetch",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the config source"
              },
              "url": {
                "type": "string",
                "description": "URL to fetch the config from"
              },
              "token": {
                "type": "string",
                "description": "Optional per-source auth token"
              }
            },
            "required": ["name", "url"]
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" }
      },
      "required": ["persistence"]
    }
  },
  "required": [],
  "definitions": {
    "svc": {
      "$comment": "This object configures a single service. Either an api service, a matrix service, or a chain service for a single chain.",
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of replicas for the chain service"
        },
        "containerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the container"
        },
        "secrets": {
          "type": "object",
          "description": "Optional secrets map"
        },
        "config": {
          "type": "object",
          "description": "Required runtime configuration"
        },
        "containerHttpPort": {
          "type": "integer",
          "description": "Port number used by the container for the main HTTP API. The running application should listen on this port."
        },
        "serviceHttpPort": {
          "type": "integer",
          "description": "Port number exposed by the service for the main HTTP API. Other applications should send requests to this port."
        },
        "containerMetricsPort": {
          "type": "integer",
          "description": "Port number used by the container for exposing a Prometheus-compatible metrics API."
        },
        "serviceMetricsPort": {
          "type": "integer",
          "description": "Port number exposed by the service for exposing the container's Prometheus-compatible metrics API. Prometheus should send requests to this port."
        },
        "resources": { "$ref": "#/definitions/resources" },
        "persistence": { "$ref": "#/definitions/persistence" }
      },
      "required": ["config"]
    },
    "resources": {
      "$comment": "Resource settings applied to this service's pods.",
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "Requested CPU units"
            },
            "memory": {
              "type": "string",
              "description": "Requested memory units"
            }
          },
          "required": ["cpu", "memory"]
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "Maximum allowed CPU units"
            },
            "memory": {
              "type": "string",
              "description": "Maximum allowed memory units"
            }
          },
          "required": ["cpu", "memory"]
        }
      },
      "required": ["requests", "limits"]
    },
    "persistence": {
      "$comment": "Persistence configuration for persistent volumes. Always creates a PVC when specified.",
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "description": "Storage size request"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
          },
          "description": "Kubernetes persistent volume access modes"
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class name for the persistent volume"
        }
      },
      "required": ["size", "accessModes"]
    },
    "initContainers": {
      "type": "array",
      "description": "List of init containers",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the init container"
          },
          "image": {
            "type": "string",
            "description": "Docker image for the init container"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Command to run in the init container"
          }
        },
        "required": ["name", "image"]
      }
    },
    "mountPath": {
      "type": "string",
      "description": "Mount path"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository"
        },
        "tag": {
          "type": "string",
          "description": "Image tag"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"],
          "description": "Kubernetes image pull policy"
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of image pull secrets"
        }
      },
      "required": ["repository", "tag"]
    }
  }
}
