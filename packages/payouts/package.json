{
  "name": "@w3f/polguard-payouts",
  "version": "0.0.1",
  "description": "One-shot CLI that claims Polkadot/Kusama validator staking rewards",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "papi",
    "build": "tsup",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "tsx tests/integration/index.ts"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "portal:.papi/descriptors",
    "@polkadot-labs/hdkd": "^0.0.28",
    "@polkadot-labs/hdkd-helpers": "^0.0.30",
    "@w3f/polguard-common": "workspace:*",
    "@w3f/polguard-config": "workspace:*",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "polkadot-api": "^2.0.1",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vitest": "^4.1.9"
  }
}
