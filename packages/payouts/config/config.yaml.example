# Payouts Service Configuration

chains:
  AssetHubPolkadot:
    rpcUrl: wss://polkadot-asset-hub-rpc.polkadot.io
signers:
  signer-x: "bottom drive obey ..."
payoutConfigsDir: ../config/examples

# --- All options ---

# environment: development       # development | production | test | staging (default: development)
# logging:
#   level: info                  # error | warn | info | debug | trace (default: info)
# claim:
#   gracePeriodEras: 16           # claim eras older than activeEra-1-gracePeriodEras (default: 16)
# notifications:                  # optional — omit for stdout only
#   matrix:
#     url: http://matrix-service/notifications
