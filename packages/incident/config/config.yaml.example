# Incident Service Configuration

# Environment (optional, default: development)
# Values: development, production, test, staging
environment: development

# Database configuration (required)
database:
  host: localhost
  port: 5432              # default: 5432
  username: postgres
  password: postgres      # or use POSTGRES_PASSWORD env var
  database: monitoring

# HTTP Server (optional, default: 3000/0.0.0.0)
server:
  port: 3000
  host: 0.0.0.0

# Notification services (required)
notifications:
  matrix:
    url: http://localhost:3001

# Logging (optional, default: debug)
# Values: error, warn, info, debug, verbose
logging:
  level: debug

# Cron schedules (optional, cron format)
crons:
  escalations: "*/5 * * * *"    # Check unacknowledged incidents
  retries: "*/2 * * * *"         # Retry failed notifications
  autoResolve: "0 */6 * * *"     # Auto-resolve orphaned incidents
