{
  "name": "@w3f/polguard-incident",
  "version": "0.0.2",
  "description": "",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "test:integration": "jest --config jest.integration.config.cjs",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push"
  },
  "dependencies": {
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^5",
    "@fastify/type-provider-typebox": "^5",
    "@sinclair/typebox": "^0.34",
    "@w3f/polguard-common": "workspace:*",
    "@w3f/polguard-config": "workspace:*",
    "cron": "^3.3.1",
    "drizzle-orm": "^0.44",
    "fastify": "^5.3.3",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "nanoid": "^3.3.4",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.29",
    "@testcontainers/postgresql": "^10.25.0",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/pg": "^8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "testcontainers": "^10.25.0",
    "tsup": "^8",
    "typescript": "~5.7.3"
  }
}
