{
  "name": "@w3f/polguard-matrix",
  "version": "0.0.2",
  "description": "",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@w3f/polguard-common": "workspace:*",
    "@w3f/polguard-config": "workspace:*",
    "fastify": "^5.3.3",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "matrix-js-sdk": "^41.4.0",
    "node-localstorage": "^3.0.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.18",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/node-localstorage": "^1.3.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "tsup": "^8",
    "typescript": "~5.7.3"
  }
}
