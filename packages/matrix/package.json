  "scripts": {
    "build": "nest build",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "start": "node dist/commonjs/src/service/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@matrix-org/olm": "^3.2.15",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.14",
    "@nestjs/core": "^11.0.14",
    "@nestjs/platform-express": "^11.0.14",
    "@nestjs/terminus": "^11.0.0",
    "@types/node-localstorage": "^1.3.3",
    "@w3f/monitoring-telemetry": "workspace:*",
    "@w3f/monitoring-types": "workspace:*",
    "axios": "^1.7.7",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "matrix-js-sdk": "^32.0",
    "node-localstorage": "^3.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.0.14",
    "@swc/core": "^1.11.18",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.7.3"
  }
