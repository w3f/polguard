# Matrix Service Configuration

matrix:
  url: https://matrix.web3.foundation
  userId: "@bot:server.org"
  passwordAuth:
    password: "***"    # or use MATRIX_PASSWORD env var
incidents:
  url: http://localhost:3000/incidents

# --- All options ---

# environment: development        # development | production | test | staging (default: development)
# matrix:
#   logging:
#     level: error                # trace | debug | info | warn | error (default: error)
#   pruneOtherDevices: true        # default: false
#   passwordAuth:
#     recoveryKey: "***"          # or MATRIX_RECOVERY_KEY env var; avoids "not verified" warnings
#   tokenAuth:                     # alternative to passwordAuth (mutually exclusive); plaintext, no encryption
#     accessToken: "***"          # or MATRIX_TOKEN env var
#     deviceId: device123
# server:
#   port: 3000                    # default: 3000
#   host: 0.0.0.0                 # default: 0.0.0.0
# logging:
#   level: debug                  # error | warn | info | debug | trace (default: debug)
