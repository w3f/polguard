environment: development

matrix:
  url: "https://matrix.web3.foundation"
  rooms:
    - id: "!roomId:web3.foundation"
  
  # Token Authentication
  enableEncryption: false  # Required for token auth
  tokenAuth:
    userId: "@your-user-id:web3.foundation"
    # accessToken can be provided via env variable MATRIX_TOKEN
    # accessToken: "your-access-token"
    deviceId: "your-device-id"
  
  # Password Authentication (it creates new sessions, avoid for dev/ci)
  # passwordAuth:
  #   userId: "@your-user-id:web3.foundation"
  #   # password can be provided via env variable MATRIX_PASSWORD
  #   # password: "your-password"
  
  # Default logging level is warn for matrix sdk, console logs are not suppresed for debug level only
  logging:
    level: debug

monitoringApi:
  baseUrl: "http://localhost:3000"
  endpoints:
    getIncidents: /incidents
    getIncident: /incidents/:id
    acknowledgeIncident: /incidents/:id/acknowledge

logging:
  level: info
