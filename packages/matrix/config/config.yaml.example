# Matrix Service Configuration

# Environment (optional, default: development)
# Values: development, production, test, staging
environment: development

# Matrix client configuration (required)
matrix:
  url: https://matrix.web3.foundation
  userId: "@bot:server.org"
  storageDir: data/local-storage    # default: data/local-storage
  
  # Matrix SDK logging (optional, default: warn)
  # Values: trace, debug, info, warn, error
  logging:
    level: warn
  
  # Authentication: choose ONE method
  passwordAuth:
    password: ***    # or use MATRIX_PASSWORD env var
  
  # OR use token auth (requires enableEncryption: false)
  # tokenAuth:
  #   accessToken: ***    # or use MATRIX_TOKEN env var
  #   deviceId: device123
  
  # enableEncryption: false    # auto-inferred from auth type

# Incident Service API (required)
incidents:
  url: http://localhost:3000/incidents

# HTTP Server (optional, default: 3000/0.0.0.0)
# Exposes notification webhook and health endpoints
server:
  port: 3001
  host: 0.0.0.0

# Logging (optional, default: debug)
# Values: error, warn, info, debug, verbose
logging:
  level: debug

# Monitoring configuration (optional)
# Used for !check command to verify monitored accounts
monitoringConfigsDir: ../config/examples    # default: ../config/examples
