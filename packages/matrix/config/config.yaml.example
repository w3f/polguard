environment: development

matrix:
  url: "https://matrix.web3.foundation"
  userId: "@your-user-id:web3.foundation"
  # password is provided via env variable MATRIX_PASSWORD
  # Default logging level is warn for matrix sdk, console logs are not suppresed for debug level only
  # logging:
    # level: debug
  rooms:
    - id: "!roomId:web3.foundation"

monitoringApi:
  baseUrl: "http://localhost:8082"
  endpoints:
    getIncidents: /incidents
    getIncident: /incidents/:id
    acknowledgeIncident: /incidents/:id/acknowledge

logging:
  level: info
