{
  "name": "@w3f/polguard-common",
  "version": "0.3.0",
  "description": "Common types, interfaces, constants and utilities for W3F monitoring services including chain watcher, matrix notifications and configuration",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/w3f/polguard.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/w3f/polguard/tree/main/packages/common",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sinclair/typebox": "^0.34",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8",
    "typescript": "~5.7.3",
    "vitest": "^4.1.9"
  }
}
