chain: Polkadot
watcherType: Chain
environment: development
redis:
  url: redis://localhost:6379/0

# List of monitoring group IDs to fetch from the Incident Management Service
monitoringGroupIds:
  - group1
  - group2
  - group3

logging:
  level: info

chainConfig:
  rpcs:
    - wss://rpc.polkadot.io
  startBlock: 1

incidentManagement:
  urls:
    create: http://incident-management:3000/incidents/create
    resolve: http://incident-management:3000/incidents/resolve

# Monitoring configuration URL
monitoringConfig:
  url: http://incident-management:3000/monitoring-config/groups

server:
  port: 3000
  host: 0.0.0.0
