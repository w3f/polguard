# Chain Service Configuration

chain:
  rpcUrl: wss://polkadot-asset-hub-rpc.polkadot.io
store:
  type: inMemory
incidentReporter:
  type: stdout
  stdout:
    format: pretty
monitoringConfigsDir: ../config/examples

# --- All options ---

# chain:
#   name: AssetHubPolkadot          # default: AssetHubPolkadot
#   rpcUrl: wss://...               # string, or a list for automatic failover
#   startBlock: 9430730             # default: latest
#   storageQueryEngine: chainHead   # chainHead | legacyRpc | getValues (default: chainHead) — see docs/NOTES.md
# environment: development          # development | production | test | staging (default: development)
# logging:
#   level: debug                    # error | warn | info | debug | trace (default: debug)
# server:
#   port: 3000                      # default: 3000
#   host: 0.0.0.0                   # default: 0.0.0.0
# store:
#   type: inMemory                  # inMemory | file | service
#   file:
#     path: ./data/chain-store.json # required if type: file
#   service:
#     url: http://localhost:3000/last-block/:chain   # required if type: service
# incidentReporter:
#   type: stdout                    # stdout | webhook | service
#   stdout:
#     format: pretty                # json | pretty (default: pretty)
#   webhook:
#     url: https://webhook.example.com   # required if type: webhook
#     headers:
#       Authorization: Bearer token
#   service:
#     url: http://localhost:3000/incidents   # required if type: service
# monitoringConfigsDir: ../config/examples   # default: ../config/examples
