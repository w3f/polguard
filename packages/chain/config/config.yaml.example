# Chain Service Configuration

# Chain configuration (optional, defaults shown)
chain:
  name: AssetHubPolkadot    # default: AssetHubPolkadot
  rpcUrl: wss://polkadot-asset-hub-rpc.polkadot.io
  # startBlock: 9430730     # optional, starts from latest if not specified

# Environment (optional, default: development)
# Values: development, production, test, staging
environment: development

# HTTP Server (optional, default: 3000/0.0.0.0)
# Exposes /health endpoint for readiness checks
server:
  port: 3002
  host: 0.0.0.0

# Logging (optional, default: debug)
# Values: error, warn, info, debug, trace
logging:
  level: debug

# State storage (optional, default: inMemory)
# Determines where last processed block is stored
store:
  type: inMemory    # inMemory (ephemeral) | service (API) | file (persistent)
  
  # Only for type: file
  # file:
  #   path: ./data/chain-store.json
  
  # Only for type: service (production with API)
  # service:
  #   url: http://localhost:3000/last-block/:chain

# Incident output (optional, default: stdout)
# Determines where incidents are sent
incidentReporter:
  type: stdout    # stdout (console) | service (API) | webhook (custom)
  
  # Only for type: stdout
  stdout:
    format: pretty    # json | pretty
  
  # Only for type: service (production with API)
  # service:
  #   url: http://localhost:3000/incidents
  
  # Only for type: webhook
  # webhook:
  #   url: https://webhook.example.com
  #   headers:
  #     Authorization: Bearer token

# Monitoring configuration (optional)
monitoringConfigsDir: ../config/examples    # default: ../config/examples
