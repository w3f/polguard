chain: AssetHubPolkadot
# startBlock: 9430730
rpc:
  url: wss://polkadot-asset-hub-rpc.polkadot.io
httpServer:
  port: 3002
  host: 0.0.0.0
monitoringApi:
  baseUrl: http://localhost:3000
  endpoints:
    createIncident: /incidents
    resolveIncident: /incidents/:id/resolve
    getConfig: /monitoring-config/groups
    getLastBlock: /last-block/:chain
    setLastBlock: /last-block
environment: development
logging:
  level: debug