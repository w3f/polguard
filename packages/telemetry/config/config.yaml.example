chain: Polkadot
pollingIntervalMs: 60000  # 1 minute for testing
monitoringGroupIds:
  - test-group-validator-1

redis:
  url: redis://localhost:6379/0
telemetryExporterApi:
  url: https://telemetry-exporter.w3f.community/feed/filtered
  basicAuth:
    username: api
    password: password
monitoringApi:
  baseUrl: http://localhost:8082
  endpoints:
    createIncident: /incidents
    resolveIncident: /incidents/resolve
    getConfig: /monitoring-config/groups

environment: development
logging:
  level: debug
