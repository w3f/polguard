{
  "name": "@w3f/polguard-config",
  "version": "0.1.15",
  "description": "Configuration processor for W3F monitoring polkadot. Handles YAML configuration loading, validation and transformation for blockchain monitoring setup",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@w3f/polguard-common": "workspace:*",
    "axios": "^1.7.7",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "tsup": "^8",
    "typescript": "~5.7.3"
  }
}
