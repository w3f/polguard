{
  "name": "@w3f/polguard-config",
  "version": "0.3.1",
  "description": "Configuration processor for W3F monitoring polkadot. Handles YAML configuration loading, validation and transformation for blockchain monitoring setup",
  "author": "W3F SecOps Team <devops@web3.foundation>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/w3f/polguard.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/w3f/polguard/tree/main/packages/config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "yarn dlx rimraf ./dist ./node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@w3f/polguard-common": "workspace:*",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8",
    "typescript": "~5.7.3",
    "vitest": "^4.1.9"
  }
}
